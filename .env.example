# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES (Vercel Project Settings)
# College Event Management System
# ============================================================
# Configure these variables in Vercel Dashboard -> Project Settings -> Environment Variables

# Cloud Database Host (e.g., gateway01.ap-southeast-1.prod.aws.tidbcloud.com)
DB_HOST=your-cloud-db-host.com

# Cloud Database Port (typically 3306 or 4000 for TiDB)
DB_PORT=3306

# Database Name (e.g., college_event_management)
DB_DATABASE=college_event_management

# Cloud Database Username (e.g., xxxxx.root)
DB_USERNAME=your_db_username

# Cloud Database Password
DB_PASSWORD=your_db_password

# Optional: Path to custom CA cert (leave blank for standard cloud TLS)
DB_SSL_CA=
